# 复制一份改名为 .env 再填写（.env 不会提交到 git）。
# 小萧要用 DeepSeek 才能工作，Key 在 DeepSeek 开放平台申请。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以 DeepSeek 开放平台当前提供的为准（可以访问 https://api.deepseek.com/models 查看）
DEEPSEEK_MODEL=deepseek-flash
# 每次调用大模型最多等多少秒
DEEPSEEK_TIMEOUT=15
# AI 服务监听的端口；改了要同步改后端 application.yml 里的 tour.ai.base-url
AI_PORT=7777
